    "m_SourceType": 1,
    "m_FunctionName": "Get_Main_Light",
    "m_FunctionSource": "",
    "m_FunctionBody": "#if SHADERGRAPH_PREVIEW\r\n\tDirection = half3(0.5, 0.5, 0);\r\n\tColor = 1;\n\tIntensity = 1;\n#else\r\n\tLight light = GetMainLight();\r\n\tDirection = light.direction;\r\n\tColor = light.color;\n\tIntensity = length(GetMainLight().color);\r\n#endif"
}

